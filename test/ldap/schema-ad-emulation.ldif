# Custom schema emulating the AD attributes the oiaf inventory scanner reads.
#
# WHY THIS FILE EXISTS: openldap's default schema has no sAMAccountName,
# userAccountControl, servicePrincipalName, lastLogonTimestamp, msDS-GroupMSAMembership,
# primaryGroupID, objectSid, and no `user`/`computer` object classes. Without them the
# scanner's search filter `(|(objectClass=user)(objectClass=computer))` matches nothing
# and the directory silently refuses to return attributes it does not know.
#
# OIDs use a private arc (1.3.6.1.4.1.99999) rather than Microsoft's, because this
# schema exists to prove the SCANNER'S BEHAVIOUR, not to be an AD clone. Matching
# Microsoft OIDs exactly would add no coverage and would risk colliding with a schema
# already present in the image.
#
# SYNTAX NOTES: every attribute is Directory String (1.3.6.1.4.1.1466.115.121.1.15)
# so the LDIF can carry plain values. objectSid in real AD is a binary SID; the scanner
# reads it with GetAttributeValue and only inspects its trailing RID, so a string form
# exercises the same code path.

dn: cn=ad-emulation,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: ad-emulation
olcAttributeTypes: {0}( 1.3.6.1.4.1.99999.1.1 NAME 'sAMAccountName' DESC 'AD logon n
 ame' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcAttributeTypes: {1}( 1.3.6.1.4.1.99999.1.2 NAME 'userAccountControl' DESC 'AD UAC
  flags' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcAttributeTypes: {2}( 1.3.6.1.4.1.99999.1.3 NAME 'servicePrincipalName' DESC 'SPN'
  EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
olcAttributeTypes: {3}( 1.3.6.1.4.1.99999.1.4 NAME 'lastLogonTimestamp' DESC 'FILETIME
 ' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcAttributeTypes: {4}( 1.3.6.1.4.1.99999.1.5 NAME 'msDS-GroupMSAMembership' DESC 'gMS
 A marker' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE
  )
olcAttributeTypes: {5}( 1.3.6.1.4.1.99999.1.6 NAME 'primaryGroupID' DESC 'primary grou
 p RID' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcAttributeTypes: {6}( 1.3.6.1.4.1.99999.1.7 NAME 'objectSid' DESC 'security identifi
 er' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcAttributeTypes: {7}( 1.3.6.1.4.1.99999.1.8 NAME 'pwdLastSet' DESC 'FILETIME' EQUALIT
 Y caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcObjectClasses: {0}( 1.3.6.1.4.1.99999.2.1 NAME 'user' DESC 'AD user emulation' SUP
  top AUXILIARY MAY ( sAMAccountName $ userAccountControl $ servicePrincipalName $ la
 stLogonTimestamp $ msDS-GroupMSAMembership $ primaryGroupID $ objectSid $ pwdLastSet
  $ displayName $ memberOf ) )
olcObjectClasses: {1}( 1.3.6.1.4.1.99999.2.2 NAME 'computer' DESC 'AD computer emulati
 on' SUP top AUXILIARY MAY ( sAMAccountName $ userAccountControl $ servicePrincipalNa
 me $ lastLogonTimestamp $ msDS-GroupMSAMembership $ primaryGroupID $ objectSid $ pwd
 LastSet $ displayName $ memberOf ) )
olcObjectClasses: {2}( 1.3.6.1.4.1.99999.2.3 NAME 'adGroup' DESC 'group placeholder' S
 UP top STRUCTURAL MUST cn MAY ( member $ description ) )
