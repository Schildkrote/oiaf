# OIAF core — systemd EnvironmentFile template (server host).
# Installed to /etc/oiaf/oiafd.env (0640 root:oiaf) by `make install-server`.
# Uncomment + set only what you need; everything has a safe default.

# Listen address (loopback only unless adapters run elsewhere)
OIAF_LISTEN_ADDR=127.0.0.1:8080

# Tokens: oiafd generates .oiaf/{admin-token,adapter-token} on first start and
# logs a warning. Set them explicitly for stable production tokens:
#OIAF_ADMIN_TOKEN=
#OIAF_ADAPTER_TOKEN=

*** Logging (debug for rollout)
#OIAF_LOG_LEVEL=info

# Integration events (OSP spine): comma-separated subscriber URLs.
# Empty = no emission (offline default).
#OIAF_WEBHOOKS=