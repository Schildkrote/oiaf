{
  "id": "deny-service-account-baseline-deviation",
  "description": "Deny service account authentication that deviates from its observed behavioural baseline (digital fencing)",
  "enabled": true,
  "priority": 210,
  "effect": "deny",
  "conditions": {
    "all": [
      {"path": "identity.type", "op": "eq", "value": "service_account"},
      {"path": "context.baseline_deviation", "op": "eq", "value": true}
    ]
  }
}
