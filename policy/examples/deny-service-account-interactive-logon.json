{
  "id": "deny-service-account-interactive-logon",
  "description": "Deny interactive logon for service accounts",
  "enabled": true,
  "priority": 200,
  "effect": "deny",
  "conditions": {
    "all": [
      {"path": "identity.type", "op": "eq", "value": "service_account"},
      {"path": "context.interactive", "op": "eq", "value": true}
    ]
  }
}
